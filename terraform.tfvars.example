# Copy this file to terraform.tfvars and adjust values.
# Run bootstrap/ FIRST to create S3 state bucket before terraform init.

aws_region          = "us-east-1"
project_name        = "borod-bank"
environment         = "dev"
vpc_cidr            = "10.0.0.0/16"
subnet_count        = 2
ssh_key_name        = "borod-bank-key"
node_instance_types = ["t3.medium"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 4
cluster_version     = "1.31"

# RDS
db_instance_class = "db.t3.micro"
db_name           = "borodbankdb"
db_username       = "admin"
# db password is managed by AWS Secrets Manager (manage_master_user_password = true)
